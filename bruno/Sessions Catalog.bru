meta {
  name: Sessions Catalog
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/v1/sessions/catalog?locale=en&focus_body_parts=chest,triceps&gender=male
  body: none
  auth: bearer
}

query {
  locale: en
  focus_body_parts: chest,triceps
  gender: male
}

auth:bearer {
  token: {{jwt}}
}

docs {
  Browse the standalone session catalog (new in engine 1.3.0) — the pool the
  single_session scope picks from.

  focus_body_parts defaults to "subset" matching, mirroring what generation
  actually does: a session is eligible only when its focus_body_parts stay
  INSIDE your selection, so it never trains a body part you did not pick.
  Pass focus_body_parts_match=contains for plain catalog browsing instead.

  Other filters: focus_muscles, focus_patterns, available_equipment, set_types,
  session_duration_minutes, min_total_sets, max_total_sets.
  Lists are comma-separated.
}
